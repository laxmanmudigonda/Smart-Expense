# Generate a long random value for production; never commit the real .env file.
SECRET_KEY=replace-with-a-random-secret
APP_ENV=development
# Set to true only when serving over HTTPS.
SESSION_COOKIE_SECURE=false
CURRENCY_SYMBOL=₹
# Optional; defaults to instance/smartexpense.db.
# DATABASE_PATH=C:\path\to\smartexpense.db
